{
  "compilerOptions": {
    "target": "es2024",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["ES2024", "DOM", "DOM.Iterable"],
    "types": [],
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "verbatimModuleSyntax": false,
    "allowImportingTsExtensions": true,
    "rewriteRelativeImportExtensions": true,
    "declarationMap": true,
    "incremental": true,
    "jsx": "react-jsx",
    "noEmit": false,
    "declaration": true,
    "rootDir": "src",
    "outDir": "lib/types",
    "tsBuildInfoFile": "lib/tsconfig.client.tsbuildinfo"
  },
  "files": [
    "src/css-modules.d.ts",
    "src/prompts.ts",
    "src/types.ts",
    "src/client/index.ts",
    "src/client/devflow-ui.ts",
    "src/client/trigger.tsx",
    "src/client/settings.tsx",
    "src/client/page.tsx"
  ]
}
